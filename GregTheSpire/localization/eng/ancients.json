  "DARV.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.ancient": "You’re a beautiful hunk of junk, you know that?",
  "DARV.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.next": "Reply",
