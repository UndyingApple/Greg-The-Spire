  "NEOW.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.next": "Continue",
  "NEOW.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-2.ancient": "[sine]...good....[/sine]",
  "NONUPEIPE.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.ancient": "Could a construct truly be worthy of my blessings?\nCome forward, GREGTHESPIRE-GREG_THE_SPIRE. You will be the most beautiful of all automata.",
  "NONUPEIPE.talk.GREGTHESPIRE-GREG_THE_SPIRE.1-0r.ancient": "My poor, battered machine, let me refine you.",
  "NONUPEIPE.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.ancient": "I usually don’t like the Architect’s things, but I admit you’re growing on me.",
  "NONUPEIPE.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.next": "Reply",
  "NONUPEIPE.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.char": "[i][font_size=22]<embarrassed chirp>[/font_size][/i]",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.ancient": "What! Servant construct?! Still working!!\nWhy here? Why not at Factory??",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.1-0r.ancient": "Shiny orbs! How work?\n[jitter]Ouch!![/jitter]",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.ancient": "Core broken? Neow use broken construct?\nManipulated?",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.next": "Reply",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.char": "[i][font_size=22]<quietly beeps>[/font_size][/i]",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.next": "Continue",
  "OROBAS.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-2.ancient": "Architect fix you?",
  "PAEL.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.ancient": "[thinky_dots]Troubled automaton, looking for your friend?\nLet me help...[/thinky_dots]",
  "PAEL.talk.GREGTHESPIRE-GREG_THE_SPIRE.1-0r.ancient": "[thinky_dots]Do constructs dream?\nWatch and copy me...[/thinky_dots]",
  "PAEL.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.ancient": "[thinky_dots]I dreamt of your friend...\nFather can restore [aqua]Flaw[/aqua]...[/thinky_dots]",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.ancient": "CONSTRUCT! NO WEAPONS!? HAVE THIS!",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.1-0r.ancient": "ORBS ARE NOT WEAPONS!!",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.ancient": "FIGHT ME, GREGTHESPIRE-GREG_THE_SPIRE!!",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.next": "Fight",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.char": "[i][font_size=22]The GREGTHESPIRE-GREG_THE_SPIRE valiantly fights.[/font_size][/i]",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.next": "Continue",
  "TANX.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-2.ancient": "ORBS [jitter]ARE[/jitter] WEAPONS!?",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.char": "[i][font_size=22]<greetings beep>[/font_size][/i]",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.next": "Continue",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-1.ancient": "Not here to annoy me? What an [jitter][b]unusual[/b][/jitter] little construct...",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.1-0r.ancient": "Now how silly would it be if he were unmade by one of his own?",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.ancient": "Are you sure you want to be fixed up?",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.next": "Reply",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.char": "[i][font_size=22]<inquisitive beep>[/font_size][/i]",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-1.next": "Continue",
  "TEZCATARA.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-2.ancient": "Well, if you’re really [jitter][b]certain[/b][/jitter].",
  "VAKUU.talk.GREGTHESPIRE-GREG_THE_SPIRE.0-0.ancient": "Broken one, let me [sine]perfect[/sine] you.",
  "VAKUU.talk.GREGTHESPIRE-GREG_THE_SPIRE.1-0r.ancient": "Do you find it strange that your fellow constructs want you dead?",
  "VAKUU.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.ancient": "If you bring me the Architect’s heart, I will restore your [aqua]companion[/aqua].",
  "VAKUU.talk.GREGTHESPIRE-GREG_THE_SPIRE.2-0.next": "Reply",
